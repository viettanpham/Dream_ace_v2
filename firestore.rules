rules_version = '2';

// ===============================================================
// Dream Ace Cloud Save — Firestore Security Rules (SV1b-1)
// ===============================================================
// TEMPORARY MODEL until real login:
// Access currently relies on Firebase Anonymous Auth + an unguessable
// 10-character Crockford Base32 Save ID + a PIN-derived PBKDF2 key verifier.
// Once real user accounts are added, bind saves/{saveId} to request.auth.uid.
//
// Collection: /saves/{saveId}
//   - get: signed-in users with a valid 10-char Crockford Base32 Save ID
//   - list: denied (prevents enumerating other players' Save IDs)
//   - create: signed-in users only if document does not yet exist (rev == 1)
//   - update: signed-in users only if verifier & salt are unchanged and rev == old rev + 1
//   - delete: denied for clients
//
// Subcollection: /saves/{saveId}/chunks/{chunkId}
//   - read (get/list): signed-in users with a valid Save ID
//   - create/update: signed-in users ONLY in the same atomic commit/transaction
//     as a parent write (enforced via existsAfter/getAfter + updatedAt == request.time)
//   - delete: denied for clients
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidSaveId(saveId) {
      return saveId is string && saveId.matches('^[0-9A-HJKMNP-TV-Z]{10}$');
    }

    function isValidChunkId(chunkId) {
      return chunkId is string && chunkId.matches('^[0-9]{1,3}$');
    }

    function hasExactSaveFields(data) {
      return data.keys().hasAll([
        'schemaVersion',
        'rev',
        'updatedAt',
        'clientUpdatedAt',
        'verifier',
        'salt',
        'iv',
        'payload',
        'compressed',
        'sizeBytes',
        'gameVersion',
        'chunkCount'
      ]) && data.keys().hasOnly([
        'schemaVersion',
        'rev',
        'updatedAt',
        'clientUpdatedAt',
        'verifier',
        'salt',
        'iv',
        'payload',
        'compressed',
        'sizeBytes',
        'gameVersion',
        'chunkCount'
      ]);
    }

    function isValidSaveDoc(data) {
      return hasExactSaveFields(data)
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 999
        && data.rev is int && data.rev >= 1
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() >= 1 && data.clientUpdatedAt.size() <= 64
        && data.verifier is string && data.verifier.size() >= 16 && data.verifier.size() <= 128
        && data.salt is string && data.salt.size() >= 12 && data.salt.size() <= 128
        && data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64
        && data.compressed is bool
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 50000000
        && data.gameVersion is string && data.gameVersion.size() >= 1 && data.gameVersion.size() <= 64
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 100
        && data.payload is string && data.payload.size() <= 950000
        && ((data.chunkCount == 0 && data.payload.size() > 0)
            || (data.chunkCount > 0 && data.payload.size() == 0));
    }

    function isValidChunkDoc(data, chunkId) {
      return data.keys().hasAll(['index', 'data', 'parentRev'])
        && data.keys().hasOnly(['index', 'data', 'parentRev'])
        && data.index is int && data.index >= 0 && data.index < 100
        && string(data.index) == chunkId
        && data.data is string && data.data.size() > 0 && data.data.size() <= 900000
        && data.parentRev is int && data.parentRev >= 1;
    }

    function isCommittedWithParent(saveId, chunkData) {
      let parentPath = /databases/$(database)/documents/saves/$(saveId);
      return existsAfter(parentPath)
        && getAfter(parentPath).data.updatedAt == request.time
        && getAfter(parentPath).data.rev == chunkData.parentRev
        && chunkData.index < getAfter(parentPath).data.chunkCount;
    }

    match /saves/{saveId} {
      allow get: if isSignedIn() && isValidSaveId(saveId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidSaveId(saveId)
        && !exists(/databases/$(database)/documents/saves/$(saveId))
        && isValidSaveDoc(request.resource.data)
        && request.resource.data.rev == 1;

      allow update: if isSignedIn()
        && isValidSaveId(saveId)
        && isValidSaveDoc(request.resource.data)
        && request.resource.data.verifier == resource.data.verifier
        && request.resource.data.salt == resource.data.salt
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schemaVersion',
          'rev',
          'updatedAt',
          'clientUpdatedAt',
          'iv',
          'payload',
          'compressed',
          'sizeBytes',
          'gameVersion',
          'chunkCount'
        ]);

      allow delete: if false;

      match /chunks/{chunkId} {
        allow get: if isSignedIn() && isValidSaveId(saveId) && isValidChunkId(chunkId);
        allow list: if isSignedIn() && isValidSaveId(saveId);

        allow create, update: if isSignedIn()
          && isValidSaveId(saveId)
          && isValidChunkId(chunkId)
          && isValidChunkDoc(request.resource.data, chunkId)
          && isCommittedWithParent(saveId, request.resource.data);

        allow delete: if false;
      }
    }
  }
}
